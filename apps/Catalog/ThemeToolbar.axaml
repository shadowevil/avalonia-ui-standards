<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Catalog.ThemeToolbar"
             HorizontalAlignment="Left">
  <Grid>
    <StackPanel x:Name="Row" Orientation="Horizontal" Spacing="12">
      <StackPanel x:Name="ThemeGroup" Orientation="Horizontal" Spacing="6">
        <TextBlock x:Name="ThemeCaption" Text="Theme" IsVisible="False" />
        <ComboBox x:Name="ThemeBox" Width="96" SelectedIndex="0" ToolTip.Tip="Theme">
          <ComboBoxItem>System</ComboBoxItem>
          <ComboBoxItem>Light</ComboBoxItem>
          <ComboBoxItem>Dark</ComboBoxItem>
        </ComboBox>
      </StackPanel>
      <StackPanel x:Name="DensityGroup" Orientation="Horizontal" Spacing="6">
        <TextBlock x:Name="DensityCaption" Text="Density" IsVisible="False" />
        <ComboBox x:Name="DensityBox" Width="104" SelectedIndex="0" ToolTip.Tip="Density">
          <ComboBoxItem>Normal</ComboBoxItem>
          <ComboBoxItem>Compact</ComboBoxItem>
        </ComboBox>
      </StackPanel>
      <StackPanel x:Name="AccentGroup" Orientation="Horizontal" Spacing="6">
        <TextBlock x:Name="AccentCaption" Text="Accent" IsVisible="False" />
        <ComboBox x:Name="AccentBox" Width="104" ToolTip.Tip="Accent colour" />
        <TextBox x:Name="AccentHex" Width="84" MaxLength="9" ToolTip.Tip="Accent colour as #RRGGBB" />
      </StackPanel>
      <StackPanel x:Name="MotionGroup" Orientation="Horizontal" Spacing="6">
        <TextBlock x:Name="MotionCaption" Text="Motion" />
        <ComboBox x:Name="MotionBox" Width="116" SelectedIndex="0" ToolTip.Tip="Reduce motion">
          <ComboBoxItem>Follow OS</ComboBoxItem>
          <ComboBoxItem>Reduced</ComboBoxItem>
          <ComboBoxItem>Full</ComboBoxItem>
        </ComboBox>
      </StackPanel>
      <StackPanel x:Name="TransparencyGroup" Orientation="Horizontal" Spacing="6">
        <TextBlock x:Name="TransparencyCaption" Text="Transparency" />
        <ComboBox x:Name="TransparencyBox" Width="116" SelectedIndex="0" ToolTip.Tip="Reduce transparency">
          <ComboBoxItem>Follow OS</ComboBoxItem>
          <ComboBoxItem>Reduced</ComboBoxItem>
          <ComboBoxItem>Full</ComboBoxItem>
        </ComboBox>
      </StackPanel>
    </StackPanel>
    <Button x:Name="MoreButton" Content="Settings" IsVisible="False">
      <Button.Flyout>
        <Flyout Placement="BottomEdgeAlignedRight">
          <StackPanel x:Name="FlyoutBody" Spacing="8" />
        </Flyout>
      </Button.Flyout>
    </Button>
  </Grid>
</UserControl>
