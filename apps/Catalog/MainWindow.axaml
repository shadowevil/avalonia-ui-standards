<StandardsWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:c="using:Catalog"
                 x:Class="Catalog.MainWindow"
                 Title="Avalonia UI Standards catalog"
                 Width="1200" Height="800">
  <StandardsWindow.Backdrop>
    <c:RibbonBackdrop x:Name="Ribbons" />
  </StandardsWindow.Backdrop>
  <StandardsWindow.Toolbar>
    <c:ThemeToolbar />
  </StandardsWindow.Toolbar>
  <StandardsWindow.Sidebar>
    <Sidebar x:Name="PageList" />
  </StandardsWindow.Sidebar>
  <StandardsWindow.StatusBar>
    <Grid x:Name="StatusRow" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
      <TextBlock x:Name="StatusPage" FontSize="{DynamicResource FontSizeCaption}" />
      <TextBlock x:Name="StatusFrames" Grid.Column="1" FontSize="{DynamicResource FontSizeCaption}" />
      <TextBlock x:Name="StatusVersion" Grid.Column="2" FontSize="{DynamicResource FontSizeCaption}" />
    </Grid>
  </StandardsWindow.StatusBar>
</StandardsWindow>
